@model QuyenGopOnline.Models.RegisterViewModel
@{
    ViewData["Title"] = "Gia nhập cộng đồng";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-body">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="auth-card animate__animated animate__zoomIn">
                    <div class="auth-header" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                        <i class="fas fa-user-plus fa-3x mb-3"></i>
                        <h2 class="fw-bold">TẠO TÀI KHOẢN</h2>
                        <p class="small opacity-75">Bắt đầu hành trình thiện nguyện của bạn</p>
                    </div>

                    <div class="auth-form-container">
                        <form asp-action="Register" method="post">
                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label small fw-bold text-muted">HỌ VÀ TÊN</label>
                                <input asp-for="FullName" class="form-control form-control-custom" placeholder="Nguyễn Văn A" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label small fw-bold text-muted">ĐỊA CHỈ EMAIL</label>
                                <input asp-for="Email" class="form-control form-control-custom" placeholder="name@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Password" class="form-label small fw-bold text-muted">MẬT KHẨU</label>
                                    <input asp-for="Password" class="form-control form-control-custom" type="password" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted">XÁC NHẬN</label>
                                    <input asp-for="ConfirmPassword" class="form-control form-control-custom" type="password" />
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="form-check mb-4">
                                <input class="form-check-input" type="checkbox" required id="terms">
                                <label class="form-check-label small text-muted" for="terms">
                                    Tôi đồng ý với <a asp-action="Privacy">Điều khoản & Chính sách</a>
                                </label>
                            </div>

                            <button type="submit" class="btn btn-success btn-auth w-100 text-white" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">HOÀN TẤT ĐĂNG KÝ</button>
                            
                            <div class="mt-4 text-center">
                                <a asp-action="Login" class="small text-decoration-none fw-bold text-success">Đã có tài khoản? Đăng nhập</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>