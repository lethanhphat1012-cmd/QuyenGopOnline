@model IEnumerable<QuyenGopOnline.Models.User>
@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="container mt-4">
    <h2 class="mb-4 fw-bold"><i class="fas fa-users-cog me-2"></i>Quản lý danh sách người dùng</h2>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Người dùng</th>
                        <th>Email</th>
                        <th>Trạng thái eKYC</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@user.FullName</div>
                                <small class="text-muted">Quyền: @user.Role</small>
                            </td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.IsVerified)
                                {
                                    <span class="badge bg-success-soft text-success border border-success px-3">
                                        <i class="fas fa-check-circle me-1"></i> Đã xác thực
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-soft text-secondary border border-secondary px-3">
                                        Chưa xác thực
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                @if (user.IsVerified)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-info me-2" 
                                            onclick="showIdCard('@user.IdCardImage')">
                                        <i class="fas fa-id-card"></i> Xem ảnh
                                    </button>
                                    
                                    <form asp-action="RevokeVerification" asp-route-id="@user.Id" 
                                          method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger" 
                                                onclick="return confirm('Bạn có chắc muốn hủy trạng thái xác thực của người dùng này?')">
                                            Hủy xác thực
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="idCardModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ảnh CCCD người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImg" src="" class="img-fluid rounded" alt="CCCD" />
            </div>
        </div>
    </div>
</div>

<script>
    function showIdCard(base64) {
        if(!base64) { alert('Không có ảnh!'); return; }
        document.getElementById('modalImg').src = base64;
        new bootstrap.Modal(document.getElementById('idCardModal')).show();
    }
</script>