@using QuyenGopOnline.Models
@model IEnumerable<QuyenGopOnline.Models.User>

@{
    ViewData["Title"] = "Quản lý xác thực";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fas fa-id-check me-2"></i>Thành viên đã xác thực CCCD</h5>
            <span class="badge bg-light text-primary">Tổng cộng: @Model.Count()</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Họ và Tên</th>
                            <th>Email</th>
                            <th>Số CCCD</th>
                            <th>Quyền hạn</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-bold">@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    <code class="text-primary fw-bold">@user.IdCardNumber</code>
                                </td>
                                <td>
                                    @if (user.Role == "PostCreator")
                                    {
                                        <span class="badge bg-danger">Người tạo bài viết</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@user.Role</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Đã Verify</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>