@model IEnumerable<QuyenGopOnline.Models.Transaction>

    @{
ViewData["Title"] = "Lịch sử quyên góp";
    }

    <div class="container mt-5">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="fas fa-history me-2"></i>Lịch sử giao dịch</h4>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light btn-sm">Quay lại Dashboard</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Ngày giao dịch</th>
                                <th>Hoàn cảnh / Bài viết</th>
                                <th>Số tiền (VNĐ)</th>
                                <th>Lời nhắn</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
{
foreach (var item in Model)
{
                            <tr>
                                <td>@item.DonationDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="fw-bold text-dark">Mã bài viết: #@item.PostId</span></td>
                                <td>
                                    <span class="text-success fw-bold">
                                        + @item.Amount.ToString("N0")
                                    </span>
                                </td>
                                <td class="text-muted small">@item.Note</td>
                                <td>
                                    <span class="badge bg-success">Thành công</span>
                                </td>
                            </tr>
}
}
else
{
                            <tr>
                                <td colspan="5" class="text-center text-muted">Chưa có giao dịch nào được thực hiện.</td>
                            </tr>
}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
