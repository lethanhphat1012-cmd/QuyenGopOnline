@model IEnumerable<QuyenGopOnline.Models.Post>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Quản lý các bài viết kêu gọi</h2>
            <a asp-action="Create" class="btn btn-success">Thêm bài viết mới</a>
        </div>

        <table class="table table-bordered shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Ảnh</th>
                    <th>Tiêu đề</th>
                    <th>Mục tiêu</th>
                    <th>Hiện có</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
{
                <tr>
                    <td><img src="@item.ImageUrl" width="80" /></td>
                    <td>@item.Title</td>
                    <td>@item.TargetAmount.ToString("N0") đ</td>
                    <td class="text-primary fw-bold">@item.CurrentAmount.ToString("N0") đ</td>
                    <td>@(item.IsActive ? "Đang chạy" : "Đã đóng")</td>
                </tr>
}
            </tbody>
        </table>
    </div>
