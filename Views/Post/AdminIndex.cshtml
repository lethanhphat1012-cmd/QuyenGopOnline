@model IEnumerable<QuyenGopOnline.Models.Post>

@{
    ViewData["Title"] = "Quản lý chiến dịch";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-posts.css" asp-append-version="true" />
}

<div class="container mt-4">
    <div class="admin-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-0">Quản lý chiến dịch</h2>
                <p class="text-muted">Danh sách các bài viết kêu gọi quyên góp hiện có</p>
            </div>
            <a asp-action="Create" class="btn btn-cta">
                <i class="fas fa-plus-circle me-2"></i>Thêm bài viết mới
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-custom">
                <thead>
                    <tr>
                        <th>Hình ảnh</th>
                        <th style="width: 30%;">Thông tin chiến dịch</th>
                        <th>Tiến độ</th>
                        <th>Hiện có / Mục tiêu</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var progress = item.TargetAmount > 0 
                        ? (item.CurrentAmount / item.TargetAmount) * 100 
                        : 0;
                        <tr>
                            <td>
                                <img src="@item.ImageUrl" class="post-img shadow-sm" alt="Thumbnail" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.Title</div>
                                <small class="text-muted">ID: #@item.Id</small>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="progress progress-sm flex-grow-1 me-2">
                                        <div class="progress-bar bg-success" style="width: @(progress > 100 ? 100 : progress)%"></div>
                                    </div>
                                    <small class="fw-bold">@progress.ToString("N0")%</small>
                                </div>
                            </td>
                            <td>
                                <div class="text-primary fw-bold">@item.CurrentAmount.ToString("N0") đ</div>
                                <div class="text-muted small">/ @item.TargetAmount.ToString("N0") đ</div>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge-active"><i class="fas fa-check-circle me-1"></i>Đang chạy</span>
                                }
                                else
                                {
                                    <span class="badge-closed"><i class="fas fa-times-circle me-1"></i>Đã đóng</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm border-0" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm border-0" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <button type="button" onclick="confirmDelete(@item.Id, '@item.Title')" class="btn btn-outline-danger btn-sm border-0" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-posts.js" asp-append-version="true"></script>
}