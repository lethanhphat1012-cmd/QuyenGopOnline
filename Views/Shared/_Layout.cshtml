@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    // Lấy thông tin từ Session để hiển thị giao diện cá nhân hóa
    var userRole = HttpContextAccessor.HttpContext?.Session.GetString("UserRole") ?? "";
    var userEmail = HttpContextAccessor.HttpContext?.Session.GetString("UserEmail") ?? "";
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UserName") ?? "Thành viên";
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuyenGopOnline</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuyenGopOnline.styles.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top custom-navbar shadow-sm">
            <div class="container">
                <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-hand-holding-heart me-2"></i>QuyenGop<span class="text-warning">Online</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
                               asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Donation" asp-action="History">Lịch sử & Sao kê</a>
                        </li>

                        @* Menu dành riêng cho Admin *@
                        @if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-controller="Post" asp-action="Dashboard">
                                    <i class="fas fa-user-shield me-1"></i> QUẢN TRỊ
                                </a>
                            </li>
                        }

                        @* Menu dành cho người đã xác thực hoặc Admin *@
                        @if (Context.Session.GetString("UserRole") == "PostCreator" || Context.Session.GetString("UserRole") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Post" asp-action="Create">Đăng bài</a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">Chính sách</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(userEmail))
                        {
                            @* Giao diện khi ĐÃ ĐĂNG NHẬP *@
                            <div class="dropdown">
                                <a class="d-flex align-items-center text-decoration-none dropdown-toggle user-dropdown" 
                                   href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="avatar-nav me-2">
                                        @userName.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="d-none d-md-inline text-dark fw-medium">@userName</span>
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 animate__animated animate__fadeIn">
                                    <li><h6 class="dropdown-header">Xin chào, @userName</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="fas fa-user-circle me-2 text-primary"></i>Hồ sơ của tôi</a>
                                    </li>
                                    @if (userRole != "PostCreator" && userRole != "Admin")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Account" asp-action="VerifyIdentity">
                                            <i class="fas fa-shield-alt me-2 text-warning"></i>Xác thực eKYC</a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                        <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            @* Giao diện khi CHƯA ĐĂNG NHẬP *@
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary px-4 rounded-pill">Đăng nhập</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary px-4 rounded-pill shadow-sm">Tham gia</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" style="min-height: 70vh; padding-top: 80px;">
        @if (ViewData["IsFullWidth"] != null && (bool)ViewData["IsFullWidth"])
        {
            @RenderBody()
        }
        else
        {
            <div class="container mt-4 mb-5">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="custom-footer border-top bg-light">
        <div class="container py-5">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="footer-title fw-bold text-primary mb-3">Về Chúng Tôi</h5>
                    <p class="small text-muted lh-lg">
                        Nền tảng quyên góp trực tuyến minh bạch, tin cậy. Nơi kết nối những tấm lòng vàng đến với những hoàn cảnh khó khăn trên khắp cả nước.
                    </p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="footer-title fw-bold text-dark mb-3">Liên Kết Nhanh</h5>
                    <ul class="list-unstyled footer-list">
                        <li><a href="#" class="text-decoration-none text-muted small py-1 d-block">Hướng dẫn quyên góp</a></li>
                        <li><a href="#" class="text-decoration-none text-muted small py-1 d-block">Báo cáo tài chính</a></li>
                        <li><a href="#" class="text-decoration-none text-muted small py-1 d-block">Điều khoản sử dụng</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="footer-title fw-bold text-dark mb-3">Kết Nối Với Chúng Tôi</h5>
                    <div class="d-flex gap-3 mb-3">
                        <a href="#" class="social-icon-btn facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-icon-btn youtube"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="social-icon-btn instagram"><i class="fab fa-instagram"></i></a>
                    </div>
                    <p class="small text-muted mb-0"><i class="fas fa-envelope me-2"></i>contact@quyengop.vn</p>
                    <p class="small text-muted"><i class="fas fa-phone me-2"></i>1900 123 456</p>
                </div>
            </div>
            <hr class="my-4 opacity-25">
            <div class="text-center small text-muted fw-medium">
                &copy; 2026 - <span class="text-primary">QuyenGopOnline</span> - Trao gửi yêu thương qua từng hành động
            </div>
        </div>
    </footer>

    @* Các thư viện cần thiết *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>