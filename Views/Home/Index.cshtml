@model IEnumerable<QuyenGopOnline.Models.Post>

    <div class="container">
        <h2 class="text-center my-4">CÁC HOÀN CẢNH CẦN GIÚP ĐỠ</h2>
        <div class="row">
            @foreach (var item in Model)
{
// Tính toán phần trăm tiến độ
var percent = item.TargetAmount > 0 ? (item.CurrentAmount / item.TargetAmount * 100) : 0;

            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <img src="@item.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted">@item.Description.Substring(0, Math.Min(item.Description.Length, 100))...</p>

                        <div class="progress mb-2" style="height: 10px;">
                            <div class="progress-bar bg-warning" style="width: @percent%"></div>
                        </div>

                        <div class="d-flex justify-content-between small fw-bold">
                            <span>Đã có: @item.CurrentAmount.ToString("N0")đ</span>
                            <span>Mục tiêu: @item.TargetAmount.ToString("N0")đ</span>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <a href="/Donation/TestDonate?postId=@item.Id" class="btn btn-danger w-100">QUYÊN GÓP NGAY</a>
                    </div>
                </div>
            </div>
}
        </div>
    </div>
